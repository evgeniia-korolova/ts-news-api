{
  "compilerOptions": {
    "target": "ES2022",                          
    "module": "ESNext",                        
    "moduleResolution": "bundler",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    
    "baseUrl": "./",
    "paths": {
      "*": ["src/*"]
    },

    "allowJs": true,
    "checkJs": false,

    "strict": true,                              
    "esModuleInterop": true,  
    "noImplicitOverride": true,                   
    "skipLibCheck": true,                        
    "forceConsistentCasingInFileNames": true,    
    "outDir": "./dist",
    "types": ["node"]
  },
  "include": ["src/**/*"]
}